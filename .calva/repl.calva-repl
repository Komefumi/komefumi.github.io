cljs꞉app.core꞉> 
(ns app.core
  (:require [reagent.dom.client :as rdom]))


;; A simple Reagent component using Hiccup syntax (Clojure data structure vectors instead of HTML)
(defn hello-component []
  [:div
   [:h1 {:style {:color "#5f7fbf"}} "Hello, ClojureScript!"]
   [:p "Welcome to your beginner-friendly Reagent setup."]])

;; This function mounts your component to the DOM
(defn render []
  (let [root-el (.getElementById js/document "app")]
    (rdom/render [hello-component] root-el)))

;; The entry point specified in shadow-cljs.edn
(defn init []
  (render)
  (println "App initialized!"))
